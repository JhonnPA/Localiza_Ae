# Copie para .env e troque os valores que começam com "gere-".
# O docker-compose.yml também lê as variáveis PG* daqui.
# Pra gerar um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Banco de dados
PGHOST=localhost
PGPORT=5432
PGDATABASE=localiza_ae
PGUSER=localiza
PGPASSWORD=gere-uma-senha-forte
# true só se o banco estiver na nuvem e pedir SSL (Render, por ex.)
PGSSL=false

# API
API_PORT=3001
# precisa ter 32+ caracteres aleatórios, senão a API nem sobe
JWT_SECRET=troque-por-um-valor-aleatorio
JWT_EXPIRES_IN=8h
